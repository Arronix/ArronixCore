<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="NLog" Version="6.1.4" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.1.4" />
    <PackageVersion Include="Ical.Net" Version="5.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageVersion Include="DryIoc.dll" Version="5.4.3" />
    <PackageVersion Include="DryIoc.Microsoft.DependencyInjection" Version="6.2.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="RestSharp" Version="114.0.0" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="Selenium.Support" Version="4.46.0" />
    <PackageVersion Include="Selenium.WebDriver.ChromeDriver" Version="150.0.7871.12400" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="NunitXml.TestLogger" Version="8.0.0" />
    <PackageVersion Include="Lib.Harmony" Version="2.4.2" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Diacritical.Net" Version="1.0.5" />
    <PackageVersion Include="Equ" Version="2.3.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Polly" Version="8.7.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="FluentMigrator.Runner" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.Postgres" Version="8.0.1" />
    <!-- Held at the 3.x line deliberately. ImageSharp 4.0.0 gates the BUILD on a paid Six Labors licence
         key ("No Six Labors license found" — SixLabors.ImageSharp.targets), so it cannot be consumed without
         a commercial subscription. 3.1.12 is the newest release usable under the Six Labors Split Licence,
         which permits free use in an OSI-licensed project such as this GPLv3 one. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="MonoTorrent" Version="3.0.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageVersion Include="IPAddressRange" Version="6.3.0" />
    <PackageVersion Include="NLog.Layouts.ClefJsonLayout" Version="1.0.5" />
    <PackageVersion Include="NLog.Targets.Syslog" Version="7.0.0" />
    <PackageVersion Include="Sentry" Version="6.8.0" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="SourceGear.sqlite3" Version="3.53.3" />
    <PackageVersion Include="System.Data.SQLite" Version="2.0.3" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
    <PackageVersion Include="ImpromptuInterface" Version="8.0.6" />
    <!-- Deliberately NOT bumped: nuget's latest *stable* release of this package is 1.0.0, which would be a
         downgrade. 5.20.1-preview is the newest release and the one carrying the Unix syscall surface that
         NzbDrone.Mono depends on (see DEPENDENCY_INVESTIGATION.md). -->
    <PackageVersion Include="Mono.Posix.NETStandard" Version="5.20.1-preview" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageVersion Include="NBuilder" Version="6.1.0" />
    <!-- Arronix.Common dependency set: Microsoft-owned only, none surfacing in its public API. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.10" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.10" />
    <!-- Arronix.Common.Tests only: FakeTimeProvider. The package id differs from its namespace,
         which is Microsoft.Extensions.Time.Testing. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <!-- Arronix.Plugins / Arronix.Host / Arronix.Web dependency set: Microsoft-owned only.
         The plugin loader and host runtime need generic-host composition, configuration binding and
         in-memory caching; the Blazor UI takes everything else from Microsoft.NET.Sdk.Web. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.10" />
    <!-- Arronix.Client: the Blazor WebAssembly PWA. The server (Arronix.Api) is a plain ASP.NET Core
         REST+SignalR host and takes none of these. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <!-- Arronix storage (owner decision 2026-08-12: EF Core; supersedes the earlier no-EF-Core rule).
         Host-side ONLY, behind the IMediaStore seam - never reachable from a plugin or the client.
         Registered ahead of the storage milestone so implementers do not touch this file. Note: the
         Sqlite provider carries the same transitive SQLitePCLRaw NU1903 advisory storage-layer.md
         records for Microsoft.Data.Sqlite; resolve it when the milestone starts. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
</Project>
