<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Arronix.Plugins.Tests</RootNamespace>
    <AssemblyName>Arronix.Plugins.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Override to mark as test project -->
    <TestProject>true</TestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arronix.Generators\Arronix.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Arronix.Plugins\Arronix.Plugins.csproj" />
  </ItemGroup>

  <!--
       The container, the configuration builder and a controllable clock are host concerns: Arronix.Plugins
       takes only the abstractions of the first two and the framework's clock for the third. The tests stand
       in for a host, so they take the implementations directly rather than relying on them arriving
       transitively.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="FluentAssertions" />
    <!--
         Declaration fixtures are compiled rather than emitted. Reflection.Emit's persisted writer cannot
         reference a constructor it defined itself from an assembly-level attribute - the token it records
         resolves to no MethodDef row - and the shapes under test are attribute applications.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
