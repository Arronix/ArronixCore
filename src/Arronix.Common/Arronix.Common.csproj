<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Arronix.Common</RootNamespace>
    <AssemblyName>Arronix.Common</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Host-side platform infrastructure for the Arronix media platform. Filesystem, outbound HTTP, caching, throttling, processes, hosting identity, serialization, redaction and telemetry composition. Never referenced by plugins.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arronix.Abstractions\Arronix.Abstractions.csproj" />
  </ItemGroup>

  <!--
       Host mechanics rather than contracts: the platform reading surface behind the hosting facts, the
       quiescence gate, and the concrete cache namespace. Arronix.Plugins builds an extension's invocation
       lifetime on the same gate, and the tests prove the branches directly.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Arronix.Common.Tests" />
    <InternalsVisibleTo Include="Arronix.Plugins" />
    <InternalsVisibleTo Include="Arronix.Plugins.Tests" />
    <InternalsVisibleTo Include="Arronix.Host" />
    <InternalsVisibleTo Include="Arronix.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
</Project>
