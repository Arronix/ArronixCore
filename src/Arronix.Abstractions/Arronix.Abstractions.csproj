<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Arronix.Abstractions</RootNamespace>
    <AssemblyName>Arronix.Abstractions</AssemblyName>
    <Version>0.3.0</Version>
    <Description>Core abstractions and contracts for the Arronix media platform. Defines media-agnostic interfaces for the media-shape model, the plugin model, providers, presentation intent, wire contracts, scheduling, parsing, quality management and orchestration.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
