<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Arronix.Plugin.Tv</RootNamespace>
    <AssemblyName>Arronix.Plugin.Tv</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Reference media extension for episodic television and the pressure test for set-shaped acquisition targets. It binds the independently owned Video format capability while its legacy shape implementation is migrated to the typed media contract.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
       A media extension references contracts plus the format capabilities it composes, never Common,
       Plugins, Host, Api or Client. It takes zero package references. Architecture tests enforce both.

       Television is the second dependant of the video package, and it closes its typed release over the
       same Video the movies package does. Like Movies it references only the domain assembly: everything a
       media declaration needs from video is domain semantics, and Arronix.Format.Video.Contributions holds
       what it does not need.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arronix.Abstractions\Arronix.Abstractions.csproj" />
    <!-- Compilation only: video is an installed package, never a private copy in this payload. -->
    <ProjectReference Include="..\Arronix.Format.Video\Arronix.Format.Video.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
