@{
}
@*
    What can be configured, grouped by the kind of external service it integrates with.

    <b>A gap, stated.</b> A catalog entry declares the identifier the extension gave it, but not which
    extension gave it. The identifier a configuration must carry is the qualified one, so an entry whose
    identifier does not already arrive qualified cannot be added from here at all. That is a missing
    member on the contract, not a missing feature here, and it is reported alongside this work rather than
    worked around by guessing at an extension's name.
*@

@foreach (var family in Families)
{
    <section class="catalog">
        <h3>@FamilyName(family.Key)</h3>
        <ul class="catalog-list">
            @foreach (var descriptor in family)
            {
                <li class="catalog-entry">
                    <div>
                        <p class="catalog-name">@descriptor.Name</p>
                        @if (!string.IsNullOrWhiteSpace(descriptor.Description))
                        {
                            <p class="catalog-detail">@descriptor.Description</p>
                        }
                    </div>

                    @if (ProviderId.TryParse(descriptor.LocalId, out var id))
                    {
                        <button type="button" class="button"
                                @onclick="@(() => OnAdd.InvokeAsync(new CatalogChoice(descriptor, id)))">
                            Add
                        </button>
                    }
                    else
                    {
                        <span class="catalog-blocked"
                              title="The catalog does not say which extension supplies this provider">
                            unavailable
                        </span>
                    }
                </li>
            }
        </ul>
    </section>
}

@if (Descriptors.Count == 0)
{
    <EmptyState Title="No providers available"
                Detail="Providers arrive with extensions. Install one to configure it here." />
}

@code {
    /// <summary>Gets or sets the providers that can be configured.</summary>
    [Parameter]
    public IReadOnlyList<ProviderDescriptor> Descriptors { get; set; } = [];

    /// <summary>Gets or sets the callback raised when the user chooses one to configure.</summary>
    [Parameter]
    public EventCallback<CatalogChoice> OnAdd { get; set; }

    private IEnumerable<IGrouping<ProviderFamily, ProviderDescriptor>> Families
        => Descriptors.GroupBy(descriptor => descriptor.Family).OrderBy(family => family.Key);

    // Closed vocabulary, every member listed, no fall-through arm: a provider family added to the
    // contract fails this build rather than appearing in settings under a blank heading.
    private static string FamilyName(ProviderFamily family) => family switch
    {
        ProviderFamily.Indexer => "Indexers",
        ProviderFamily.Downloader => "Download Clients",
        ProviderFamily.Notifier => "Notifications",
        ProviderFamily.Cataloger => "Metadata",
        ProviderFamily.Curator => "Import Lists",
    };

    /// <summary>A provider the user has chosen to configure.</summary>
    /// <param name="Descriptor">What the provider declared about itself.</param>
    /// <param name="Provider">Its qualified identifier.</param>
    public sealed record CatalogChoice(ProviderDescriptor Descriptor, ProviderId Provider);
}
