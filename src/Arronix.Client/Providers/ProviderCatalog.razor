@{
}
@*
    What can be configured, grouped by the kind of external service it integrates with.

    Each entry arrives with the qualified identifier a configuration must carry and the family it belongs
    to, both minted host-side. Neither is reconstructed here: the earlier attempt to read an extension's
    identity out of a local name could not succeed, and every entry rendered as unavailable because of it.
*@

@foreach (var family in Families)
{
    <section class="catalog">
        <h3>@FamilyName(family.Key)</h3>
        <ul class="catalog-list">
            @foreach (var entry in family)
            {
                <li class="catalog-entry">
                    <div>
                        <p class="catalog-name">@entry.Descriptor.Name</p>
                        @if (!string.IsNullOrWhiteSpace(entry.Descriptor.Description))
                        {
                            <p class="catalog-detail">@entry.Descriptor.Description</p>
                        }
                    </div>

                    <button type="button" class="button" @onclick="@(() => OnAdd.InvokeAsync(entry))">
                        Add
                    </button>
                </li>
            }
        </ul>
    </section>
}

@if (Entries.Count == 0)
{
    <EmptyState Title="No providers available"
                Detail="Providers arrive with extensions. Install one to configure it here." />
}

@code {
    /// <summary>Gets or sets the providers that can be configured.</summary>
    [Parameter]
    public IReadOnlyList<ProviderCatalogEntry> Entries { get; set; } = [];

    /// <summary>Gets or sets the callback raised when the user chooses one to configure.</summary>
    [Parameter]
    public EventCallback<ProviderCatalogEntry> OnAdd { get; set; }

    private IEnumerable<IGrouping<ProviderFamily, ProviderCatalogEntry>> Families
        => Entries.GroupBy(entry => entry.Family).OrderBy(family => family.Key);

    // Closed vocabulary, every member listed, no fall-through arm: a provider family added to the
    // contract fails this build rather than appearing in settings under a blank heading.
    private static string FamilyName(ProviderFamily family) => family switch
    {
        ProviderFamily.Indexer => "Indexers",
        ProviderFamily.Downloader => "Download Clients",
        ProviderFamily.Notifier => "Notifications",
        ProviderFamily.Cataloger => "Metadata",
        ProviderFamily.Curator => "Import Lists",
    };
}
