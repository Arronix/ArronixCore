@{
#pragma warning disable ARX0017 // Wire contracts are experimental; the items are them.
}
@*
    Following a collection that cuts across the hierarchy. The collections themselves come from the
    server, because membership is many-to-many and a client cannot infer it from a page of items; opening
    one lists what is in it.
*@

<ItemCollection Kind="Context.Kind"
                Level="Context.Level"
                Items="Context.Items"
                OnOpen="Context.OnOpen"
                EmptyDetail="@($"No {Context.Axis.Name.ToLowerInvariant()} yet.")" />

@code {
    /// <summary>Gets or sets what is being drawn.</summary>
    [Parameter]
    [EditorRequired]
    public required PresenterContext Context { get; set; }
}
