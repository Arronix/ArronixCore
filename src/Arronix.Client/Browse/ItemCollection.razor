@{
#pragma warning disable ARX0017 // Wire contracts are experimental; the items are them.
#pragma warning disable ARX0013 // Shape contracts are experimental; columns come from field descriptors.
#pragma warning disable ARX0016 // Intent contracts are experimental; declared states are drawn here.
}
@*
    A run of items, drawn as cards or as rows. Which of the two is a preference of the person looking,
    not a property of the media kind, so it is a parameter rather than a declaration.
*@

@if (Items.Count == 0)
{
    <EmptyState Title="Nothing here" Detail="@EmptyDetail" />
}
else if (AsTable)
{
    <div class="table-scroll">
        <table class="item-table">
            <thead>
                <tr>
                    <th scope="col">@(Level.Name)</th>
                    @foreach (var field in Columns)
                    {
                        <th scope="col">@field.Name</th>
                    }
                    <th scope="col">State</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>
                        <th scope="row">
                            <button type="button" class="link" @onclick="@(() => OnOpen.InvokeAsync(item))">
                                @item.Item.Title
                            </button>
                        </th>
                        @foreach (var field in Columns)
                        {
                            <td>
                                <FieldValueView Descriptor="field"
                                                Value="@(item.Item.Fields.TryGetValue(field.FieldId, out var value) ? value : null)"
                                                Compact="true" />
                            </td>
                        }
                        <td><StateIndicator States="ItemProjection.States(Kind.Intent, item)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card-grid">
        @foreach (var item in Items)
        {
            <ItemCard Kind="Kind" Item="item" OnOpen="OnOpen" />
        }
    </div>
}

@code {
    /// <summary>Gets or sets the media kind's description.</summary>
    [Parameter]
    [EditorRequired]
    public required MediaKindDescriptor Kind { get; set; }

    /// <summary>Gets or sets the level the items nominally belong to.</summary>
    [Parameter]
    [EditorRequired]
    public required LevelPresentation Level { get; set; }

    /// <summary>Gets or sets the items.</summary>
    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<ItemDetail> Items { get; set; }

    /// <summary>Gets or sets a value indicating whether the items are drawn as rows rather than cards.</summary>
    [Parameter]
    public bool AsTable { get; set; }

    /// <summary>Gets or sets what to say when there is nothing to draw.</summary>
    [Parameter]
    public string? EmptyDetail { get; set; }

    /// <summary>Gets or sets the callback raised when the user opens an item.</summary>
    [Parameter]
    public EventCallback<ItemDetail> OnOpen { get; set; }

    private IReadOnlyList<FieldDescriptor> Columns
        => ItemProjection.FieldsUpTo(Level, Prominence.Secondary).Take(5).ToList();
}
