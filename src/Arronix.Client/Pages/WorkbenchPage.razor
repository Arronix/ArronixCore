@page "/kinds/{Kind}/workbenches/{WorkbenchId}"
@{
#pragma warning disable ARX0016 // Intent contracts are experimental; the surface is declared by them.
#pragma warning disable ARX0017 // Wire contracts are experimental; the descriptor is one.
}
@inject DescriptorCache Descriptors
@*
    A declared working surface, reached by its own address so that it can be linked to, bookmarked and
    returned to — which matters for the one workflow this whole primitive exists to serve, where a person
    is part-way through assigning a folder's worth of files.
*@

@if (_descriptor is { } descriptor && _workbench is { } workbench)
{
    <WorkbenchView Kind="descriptor" Descriptor="workbench" />
}
else if (_missing)
{
    <EmptyState Title="No such working surface"
                Detail="This media kind does not declare one under that name." />
}
else
{
    <LoadingIndicator Message="Reading the working surface…" />
}

@code {
    private MediaKindDescriptor? _descriptor;
    private WorkbenchDescriptor? _workbench;
    private bool _missing;

    /// <summary>Gets or sets the media kind named in the address.</summary>
    [Parameter]
    public string? Kind { get; set; }

    /// <summary>Gets or sets the working surface named in the address.</summary>
    [Parameter]
    public string? WorkbenchId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _missing = false;
        _descriptor = null;
        _workbench = null;

        if (string.IsNullOrWhiteSpace(Kind) || string.IsNullOrWhiteSpace(WorkbenchId))
        {
            _missing = true;
            return;
        }

        try
        {
            _descriptor = await Descriptors.GetAsync(MediaKindId.FromString(Kind));
            _workbench = _descriptor?.Intent.Workbenches
                .FirstOrDefault(bench => string.Equals(bench.WorkbenchId, WorkbenchId, StringComparison.Ordinal));
            _missing = _workbench is null;
        }
        catch (HostUnreachableException)
        {
            // Said once, by the shell.
        }
    }
}
