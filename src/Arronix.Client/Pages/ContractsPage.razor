@page "/contracts"
@using Arronix.Client.Contracts
@using Arronix.Client.Serialization
@implements IDisposable
@inject ContractView View
@*
    What this browser verified, what it loaded, and what the host said each of them should be.

    Every row states both sides rather than a verdict computed elsewhere: the failure this design prevents
    is rendering something plausible out of a contract that is not the one the host admitted, and seeing
    that requires reading what each side said.

    The facets the host withheld are rendered here, because a missing media kind is the same question from
    the other end, and so are the assemblies this page holds which the host no longer names. This page names
    no media kind and no media assembly.
*@

@{
    // Once per render, by one reference: separate reads of the same facts describe separate moments.
    var snapshot = View.Snapshot;
}

<h1>Media contracts</h1>

<p class="page-lead">
    The client compiles against the universal contract assembly and nothing else. Installed media contracts
    arrive from this host at run time and are proved against what it published — length, content hash,
    declared identity, declared build and declared contract reference — before the browser runtime is
    allowed near them.
</p>

<div class="page-actions">
    <button class="button" type="button" disabled="@_busy" @onclick="ReloadAsync">Reload contracts</button>
    <button class="button button-quiet" type="button" disabled="@_busy" @onclick="DiscardStoredBytesAsync">Discard stored bytes</button>
    <span class="chip chip-quiet" id="contract-store-mode">@StoreMode(snapshot)</span>
</div>

@if (snapshot.Report is { } report)
{
    @*
        The same report, verbatim, for a browser driver to read. Rendered rather than exposed through script
        interop so that what a proof harness reads is exactly what a person on this page is looking at: a
        surface that could disagree with the rendered one would be proving itself.
    *@
    <pre id="contract-proof" hidden>@ProofText(report)</pre>

    <section class="panel" id="contract-summary">
        <header class="panel-head">
            <h2>Installation</h2>
            <span class="chip" id="contract-compatibility">@report.Compatibility</span>
            <span class="chip chip-quiet" id="contract-can-project">@(report.CanProject ? "projection permitted" : "projection withheld")</span>
        </header>

        <dl class="contract-facts">
            <dt>Client contract</dt>
            <dd id="client-contract-identity">@report.ClientContractIdentity</dd>

            <dt>Host contract</dt>
            <dd id="host-contract-identity">@(report.PublishedContractIdentity ?? "—")</dd>

            <dt>Installation hash</dt>
            <dd id="installation-hash">@(report.InstallationHash ?? "—")</dd>

            <dt>Stored keys</dt>
            <dd id="stored-key-count">@snapshot.StoredKeys.Count</dd>
        </dl>

        @if (report.Failure is { Length: > 0 } failure)
        {
            <p class="panel-detail tone-problem" id="contract-failure">@failure</p>
        }

        @*
            Every failure, not the latest one, and read off the snapshot captured above — so what this page
            says about a failure belongs to the installation it shows.
        *@
        @foreach (var failed in snapshot.Failures)
        {
            <p class="panel-detail tone-problem contract-reload-failure" data-stage="@failed.Stage">
                The last change to what this page holds failed at @failed.Stage: @failed.Message
            </p>
        }

    </section>

    @if (report.Refused.Count > 0)
    {
        <section class="panel" id="contract-refusals">
            <header class="panel-head">
                <h2>Withheld by this host</h2>
                <span class="chip">@report.Refused.Count</span>
            </header>

            <ul class="plugin-list">
                @foreach (var refusal in report.Refused)
                {
                    <li class="plugin tone-problem contract-refusal" data-package="@refusal.Package.Value">
                        <div class="plugin-head">
                            <p class="plugin-name">@refusal.Package.Value</p>
                            @foreach (var cause in refusal.CausedBy)
                            {
                                <span class="chip">caused by @cause.Value</span>
                            }
                        </div>
                        <p class="plugin-message">@refusal.Reason</p>
                        @if (refusal.MissingAssemblies.Count > 0)
                        {
                            <p class="plugin-capabilities">
                                <span class="plugin-version">cannot reach</span>
                                @foreach (var assembly in refusal.MissingAssemblies)
                                {
                                    <span class="chip chip-quiet">@assembly</span>
                                }
                            </p>
                        }
                        @if (refusal.UnadmittedFiles.Count > 0)
                        {
                            <p class="plugin-capabilities">
                                <span class="plugin-version">never admitted</span>
                                @foreach (var file in refusal.UnadmittedFiles)
                                {
                                    <span class="chip chip-quiet">@file</span>
                                }
                            </p>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (report.Orphaned.Count > 0)
    {
        <section class="panel" id="contract-orphans">
            <header class="panel-head">
                <h2>Held here, no longer installed</h2>
                <span class="chip">@report.Orphaned.Count</span>
            </header>

            <p class="panel-detail">
                A browser cannot unload an assembly. These stay in this page for as long as it is open and
                are refused for projection; reload the page to run only what this host admits.
            </p>

            <ul class="plugin-list">
                @foreach (var orphan in report.Orphaned)
                {
                    <li class="plugin tone-problem contract-orphan"
                        data-assembly="@orphan.Verified.AssemblyName"
                        data-package="@orphan.PackageId.Value"
                        data-owner="@orphan.Owner">
                        <div class="plugin-head">
                            <p class="plugin-name">@orphan.Verified.FileName</p>
                            <span class="chip">@orphan.Owner</span>
                            <span class="plugin-version">@orphan.PackageName @orphan.PackageVersion</span>
                        </div>
                        <p class="plugin-message">@Explain(orphan)</p>
                    </li>
                }
            </ul>
        </section>
    }

    @if (report.Packages.Count == 0)
    {
        <EmptyState Title="No media contracts"
                    Detail="This host publishes no contract assembly a client may load." />
    }

    @foreach (var package in report.Packages)
    {
        <section class="panel contract-package" id="@($"contract-package-{package.Id.Value}")">
            <header class="panel-head">
                <h2>@package.Name</h2>
                <span class="chip">@package.Id.Value</span>
                <span class="plugin-version">@package.Version</span>
            </header>

            <dl class="contract-facts">
                <dt>Closure</dt>
                <dd class="contract-closure">@string.Join(" → ", package.Closure.Select(member => member.Value))</dd>

                <dt>Closure hash</dt>
                <dd class="contract-closure-hash">@package.ClosureHash</dd>
            </dl>

            <ul class="plugin-list">
                @foreach (var assembly in package.Assemblies)
                {
                    <li class="plugin contract-assembly @(IsResident(assembly) ? "tone-positive" : "tone-problem")"
                        data-assembly="@assembly.Published.AssemblyName"
                        data-outcome="@assembly.Outcome"
                        data-source="@assembly.Source">
                        <div class="plugin-head">
                            <p class="plugin-name">@assembly.Published.FileName</p>
                            <span class="chip">@assembly.Outcome</span>
                            <span class="chip chip-quiet">@assembly.Source</span>
                        </div>

                        <dl class="contract-facts">
                            <dt>Published identity</dt>
                            <dd>@assembly.Published.Identity</dd>

                            <dt>Declared identity</dt>
                            <dd>@(assembly.ObservedIdentity ?? "—")</dd>

                            <dt>Published content hash</dt>
                            <dd>@assembly.Published.ContentHash</dd>

                            <dt>Observed content hash</dt>
                            <dd>@(assembly.ObservedContentHash ?? "—")</dd>

                            <dt>Published module</dt>
                            <dd>@assembly.Published.ModuleVersionId</dd>

                            <dt>Declared module</dt>
                            <dd>@(assembly.ObservedModuleVersionId?.ToString() ?? "—")</dd>

                            <dt>Published bytes</dt>
                            <dd>@assembly.Published.Length</dd>

                            <dt>Observed bytes</dt>
                            <dd>@(assembly.ObservedLength?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "—")</dd>

                            <dt>Declared contract reference</dt>
                            <dd>@(assembly.ObservedContractReference ?? "—")</dd>
                        </dl>

                        @if (assembly.Failure is { Length: > 0 } assemblyFailure)
                        {
                            <p class="plugin-message">@assemblyFailure</p>
                        }
                    </li>
                }
            </ul>
        </section>
    }
}
else
{
    <LoadingIndicator Message="Reading what this host publishes…" />
}

<ContractPayloadPanel Installation="@snapshot.Report" />

@code {
    private bool _busy;

    private static string StoreMode(ContractReloadResult snapshot) => snapshot.Report?.StoreAvailable == true
        ? "persistent store"
        : "no persistent store";

    private static string ProofText(ContractLoadReport report)
        => System.Text.Json.JsonSerializer.Serialize(report, ApiJsonOptions.Default);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        View.Changed += OnChanged;
        await ReloadAsync();
    }

    /// <inheritdoc />
    public void Dispose() => View.Changed -= OnChanged;

    private static bool IsResident(LoadedContractAssembly assembly)
        => assembly.Outcome is ContractLoadOutcome.Loaded or ContractLoadOutcome.AlreadyLoaded;

    /// <remarks>Derived, not stored: the host keeps no history beyond what its package means now.</remarks>
    private static string Explain(OrphanedContract orphan) => orphan.Owner switch
    {
        OrphanedContractOwner.Withheld =>
            $"This host withholds the client facet of '{orphan.PackageId.Value}': {orphan.Refusal?.Reason}",
        OrphanedContractOwner.Offered =>
            $"'{orphan.PackageId.Value}' no longer offers '{orphan.Verified.FileName}' to a client.",
        _ => $"This host no longer offers the package '{orphan.PackageId.Value}'.",
    };

    /// <remarks>
    /// <see langword="async"/> <see langword="void"/> on purpose, as the view's own observer is: a
    /// discarded task takes a failed render with it and this page then silently stops following the view.
    /// </remarks>
    private async void OnChanged(object? sender, EventArgs e) => await InvokeAsync(StateHasChanged);

    private async Task ReloadAsync()
    {
        _busy = true;

        try
        {
            // Through the one view every caller shares, so this button cannot overlap an automatic
            // reload.
            await View.ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <remarks>
    /// Through the same view, so emptying the store cannot overlap a reload and leave this page describing
    /// a moment that never existed.
    /// </remarks>
    private async Task DiscardStoredBytesAsync()
    {
        _busy = true;

        try
        {
            await View.DiscardStoredBytesAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
