@page "/settings"
@page "/settings/providers"
@{
}
@inject ArronixApiClient Api
@*
    The settings shell.

    Only one section exists in this milestone, and it is the one that proves the point: five families of
    external service, all configured through one catalog, one list and one form, because each of them
    declares its configuration in the same vocabulary. Adding a sixth family costs a name in one table.
*@

<h1>Settings</h1>

<nav class="settings-nav" aria-label="Settings sections">
    <span class="settings-section is-selected">Providers</span>
</nav>

<ErrorNotice Message="@_error" OnRetry="LoadAsync" OnDismiss="@(() => _error = null)" />

@if (_editing is { } editing)
{
    <ProviderForm Entry="editing.Entry"
                  Definition="editing.Definition"
                  OnSaved="OnSavedAsync"
                  OnCanceled="@(() => _editing = null)" />
}
else
{
    <div class="columns">
        <section class="column">
            <h2>Configured</h2>
            @if (_busy)
            {
                <LoadingIndicator Message="Reading providers…" />
            }
            else
            {
                <ProviderDefinitionList Definitions="_definitions" OnOpen="EditAsync" />
            }
        </section>

        <section class="column">
            <h2>Available</h2>
            <ProviderCatalog Entries="_providers" OnAdd="AddAsync" />
        </section>
    </div>
}

@code {
    private IReadOnlyList<ProviderCatalogEntry> _providers = [];
    private IReadOnlyList<ProviderDefinition> _definitions = [];
    private Editing? _editing;
    private string? _error;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            _providers = await Api.GetProvidersAsync();
            _definitions = await Api.GetProviderDefinitionsAsync();
        }
        catch (HostUnreachableException)
        {
            // Said once, by the shell.
        }
        catch (Exception failure)
        {
            _error = failure.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void AddAsync(ProviderCatalogEntry entry) => _editing = new Editing(entry, null);

    private void EditAsync(ProviderDefinition definition)
    {
        // The stored configuration names the qualified identifier the catalog now serves, so the match is
        // an equality on one identity rather than a comparison of two spellings of a local name.
        var entry = _providers.FirstOrDefault(candidate => candidate.Provider == definition.Provider);

        if (entry is null)
        {
            // The configuration outlived its implementation. The platform keeps it rather than deleting
            // it, so the client says so rather than pretending it is not there.
            _error = $"'{definition.Name}' is configured for a provider that is no longer installed.";
            return;
        }

        _editing = new Editing(entry, definition);
    }

    private async Task OnSavedAsync()
    {
        _editing = null;
        await LoadAsync();
    }

    private sealed record Editing(ProviderCatalogEntry Entry, ProviderDefinition? Definition);
}
