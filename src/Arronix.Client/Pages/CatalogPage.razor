@page "/kinds/{Kind}/catalog"
@inject DescriptorCache Descriptors
@inject NavigationManager Navigation

@if (_descriptor is { } descriptor)
{
    <CatalogWorkspace Kind="descriptor" OnOpenItem="OpenAsync" />
}
else if (_missing)
{
    <EmptyState Title="No such library"
                Detail="Nothing is registered under that name. An extension may have been removed." />
}
else
{
    <LoadingIndicator Message="Reading the library…" />
}

@code {
    private MediaKindDescriptor? _descriptor;
    private bool _missing;

    /// <summary>Gets or sets the media kind named in the address.</summary>
    [Parameter]
    public string? Kind { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _missing = false;
        _descriptor = null;

        if (string.IsNullOrWhiteSpace(Kind))
        {
            _missing = true;
            return;
        }

        try
        {
            _descriptor = await Descriptors.GetAsync(MediaKindId.FromString(Kind));
            _missing = _descriptor is null;
        }
        catch (HostUnreachableException)
        {
            // Said once by the application shell.
        }
    }

    private void OpenAsync(ItemView item)
        => Navigation.NavigateTo(
            $"kinds/{Uri.EscapeDataString(item.Ref.Kind.Value)}/items/{Uri.EscapeDataString(ApiPaths.ItemReference(item.Ref))}");
}
