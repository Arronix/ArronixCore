<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Arronix.Plugin.Movies</RootNamespace>
    <AssemblyName>Arronix.Plugin.Movies</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Reference media extension for feature films. It directly closes the common MediaItem, ReleaseTarget and Release types over movie-owned vocabularies and the independently owned Video representation.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
       A media extension references contracts plus the format capabilities it composes, never Common,
       Plugins, Host, Api or Client. It takes zero package references. Architecture tests enforce both.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arronix.Abstractions\Arronix.Abstractions.csproj" />
    <ProjectReference Include="..\Arronix.Format.Video\Arronix.Format.Video.csproj" />
    <ProjectReference Include="..\Arronix.Generators\Arronix.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
