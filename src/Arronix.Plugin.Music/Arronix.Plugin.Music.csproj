<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Arronix.Plugin.Music</RootNamespace>
    <AssemblyName>Arronix.Plugin.Music</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Reference media extension for recorded music. Declares a four-level shape in which the acquisition unit and the file-bearing unit are different levels, and in which competing pressings of one work are selectable variants. References Arronix.Abstractions and nothing else.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
       Invariant 2: a media extension references Arronix.Abstractions and nothing else - no Common, no
       Host, no Plugins, no Api - and takes no package references at all. Both halves are asserted
       mechanically by the governance tests, so this file is the declaration they read.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arronix.Abstractions\Arronix.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
