<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Arronix.Host.Tests</RootNamespace>
    <AssemblyName>Arronix.Host.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Override to mark as test project -->
    <TestProject>true</TestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arronix.Generators\Arronix.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Arronix.Host\Arronix.Host.csproj" />
    <ProjectReference Include="..\Arronix.Host.Tests.G02AdmissionFixture\Arronix.Host.Tests.G02AdmissionFixture.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
       The four reference media kinds, so that the shape gate is proved against the declarations it was
       designed from rather than only against fixtures written alongside it. A fixture agrees with the
       validator by construction; a real declaration written by someone else does not.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arronix.Plugin.Books\Arronix.Plugin.Books.csproj" />
    <ProjectReference Include="..\Arronix.Plugin.Movies\Arronix.Plugin.Movies.csproj" />
    <ProjectReference Include="..\Arronix.Plugin.Music\Arronix.Plugin.Music.csproj" />
    <ProjectReference Include="..\Arronix.Plugin.Tv\Arronix.Plugin.Tv.csproj" />
    <ProjectReference Include="..\Arronix.Language.Reference\Arronix.Language.Reference.csproj" />
  </ItemGroup>

  <!--
       Stage the actual Movies build output as an installed plugin. The integration test consumes this
       directory through discovery and the complete Host loader; referencing Movies in-process is not the
       proof. G02 changes the asserted admission outcome, not this fixture path.

       Staged by publishing rather than by copying the project's bin directory, and the difference is the
       whole reliability of every payload rule below. MSBuild does not delete an assembly that a removed
       ProjectReference stopped producing, so a bin folder can keep a file the project no longer depends
       on - and a recursive copy would carry it into the payload, where a test would faithfully report a
       dependency that does not exist. Publish computes the runtime closure from the current reference set
       instead of listing a directory, so a stale file in bin cannot reach the payload at all.
  -->
  <Target Name="StagePackagedMoviesPlugin" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)PackagedPlugins\movies" />
    <MSBuild
      Projects="..\Arronix.Plugin.Movies\Arronix.Plugin.Movies.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);NoBuild=true;PublishDir=$(MSBuildProjectDirectory)\$(OutDir)PackagedPlugins\movies\" />
  </Target>

  <!--
       Stage the television payload beside the movies one, in a directory the loader never discovers. The
       payload rules are about what an installable package contains, and a rule proved against one package
       is a rule about that package: Television is the second video dependant, so it is the case that would
       show a format's executable half leaking back into a payload through some other route.
  -->
  <Target Name="StageMediaExtensionPayloads" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)PackagePayloads" />
    <MSBuild
      Projects="..\Arronix.Plugin.Tv\Arronix.Plugin.Tv.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);NoBuild=true;PublishDir=$(MSBuildProjectDirectory)\$(OutDir)PackagePayloads\tv\" />
  </Target>

  <!--
       Stage a purpose-built extension with a kind, provider, language, job and health contributor. It is a
       project dependency but not a compile-time reference: the acceptance test can reach its types only by
       sending this package through discovery and the isolated loader.
  -->
  <Target Name="StageG02AdmissionFixturePlugin" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)G02PackagedPlugins\g02.admission.fixture" />
    <MSBuild
      Projects="..\Arronix.Host.Tests.G02AdmissionFixture\Arronix.Host.Tests.G02AdmissionFixture.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);NoBuild=true;PublishDir=$(MSBuildProjectDirectory)\$(OutDir)G02PackagedPlugins\g02.admission.fixture\" />
  </Target>

  <!--
       The container, the configuration builder and the logger are host concerns the tested assembly takes
       only the abstractions of. These tests stand in for a host, so they take the implementations directly.
       The controllable clock is what makes the scheduler's ladders and the health aggregator's timeouts
       assertable without waiting for real time to pass.
  -->
  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
</Project>
