<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Arronix.Architecture.Tests</RootNamespace>
    <AssemblyName>Arronix.Architecture.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Override to mark as test project -->
    <TestProject>true</TestProject>
  </PropertyGroup>

  <!--
       DELIBERATELY SHORT, AND THE SHORTNESS IS THE POINT.

       This fixture asserts the platform's enforcement topology. Most of what it asserts is read from the
       repository - project files, source files and manifests - rather than from compiled references, so
       that a rule keeps being checked even while a project it is about is mid-rewrite and does not build.
       Three platform projects are referenced because rules genuinely need running code:

         Arronix.Abstractions  - contract and typed-media rules inspect the real public surface.
         Arronix.Plugins       - the bidirectional capability rule drives the REAL admission gate and the
                                 REAL registration ledger. A re-implementation of either here would assert
                                 that this fixture agrees with itself.
         Arronix.Host          - typed media binding and provider activation tests exercise the real host
                                 boundary rather than a duplicate test implementation.

       The four media extensions are referenced for the same reason: the capability rule is asserted by
       configuring the actual extensions against the actual registry, not by configuring a fixture written
       to pass. The API and Client rules are read from the repository, so this project does not reference
       either edge.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arronix.Abstractions\Arronix.Abstractions.csproj" />
    <ProjectReference Include="..\Arronix.Plugins\Arronix.Plugins.csproj" />
    <ProjectReference Include="..\Arronix.Host\Arronix.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arronix.Plugin.Books\Arronix.Plugin.Books.csproj" />
    <ProjectReference Include="..\Arronix.Plugin.Movies\Arronix.Plugin.Movies.csproj" />
    <ProjectReference Include="..\Arronix.Plugin.Music\Arronix.Plugin.Music.csproj" />
    <ProjectReference Include="..\Arronix.Plugin.Tv\Arronix.Plugin.Tv.csproj" />
  </ItemGroup>
</Project>
