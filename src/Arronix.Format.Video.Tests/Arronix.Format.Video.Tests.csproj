<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Arronix.Format.Video.Tests</RootNamespace>
    <AssemblyName>Arronix.Format.Video.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TestProject>true</TestProject>
  </PropertyGroup>

  <!-- The video package's test project, so it references both halves of it. -->
  <ItemGroup>
    <ProjectReference Include="..\Arronix.Format.Video\Arronix.Format.Video.csproj" />
    <ProjectReference Include="..\Arronix.Format.Video.Contributions\Arronix.Format.Video.Contributions.csproj" />
  </ItemGroup>
</Project>
