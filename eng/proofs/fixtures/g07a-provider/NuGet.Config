<?xml version="1.0" encoding="utf-8"?>
<!--
     One source, machine sources cleared. Everything these projects compile against must arrive as a
     published package; eng/proofs/g07a-external-consumer.sh fills the folder by packing, on every run.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="arronix-local" value="../../../../artifacts/g07a/feed" />
  </packageSources>
</configuration>
