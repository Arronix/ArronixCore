<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="g07b-proof" value="../../../../artifacts/g07b-browser-proof/feed" />
  </packageSources>
  <!--
       An isolated global packages folder, declared here rather than passed on the command line, so that
       this fixture restores hermetically however it is invoked: directly, or through the installation
       composer's own publish, which knows nothing about this proof and passes no extra arguments. Without
       this, a plain restore would fall back to the operator's ambient package cache, and a proof-only
       package could collide there with an identically versioned package built differently on a previous run.
  -->
  <config>
    <add key="globalPackagesFolder" value="../../../../artifacts/g07b-browser-proof/nuget-cache" />
  </config>
</configuration>
