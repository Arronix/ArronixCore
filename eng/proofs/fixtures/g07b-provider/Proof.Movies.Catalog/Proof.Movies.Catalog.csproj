<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Proof.Movies.Catalog</RootNamespace>
    <AssemblyName>Proof.Movies.Catalog</AssemblyName>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Description>Proof-only deterministic Movies cataloger for the G07B browser evidence.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arronix.Abstractions" Version="0.9.0" />
    <!-- Compile only: the installed Movies package supplies the one shared domain assembly. -->
    <PackageReference Include="Arronix.Media.Movies" Version="0.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
