<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Northmark.Shorts.Extension</RootNamespace>
    <AssemblyName>Northmark.Shorts</AssemblyName>
    <Version>1.0.0</Version>
    <Description>The entry assembly of the Northmark shorts package: the media declaration, its release parser and its plugin module.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arronix.Sdk" Version="0.9.0" />
    <!-- This package publishes the domain assembly, so its runtime asset belongs in this output. -->
    <PackageReference Include="Northmark.Shorts.Domain" Version="1.0.0" />
    <!-- Video is installed separately; a copy here would be a second CLR identity for a shared type. -->
    <PackageReference Include="Arronix.Format.Video" Version="0.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
