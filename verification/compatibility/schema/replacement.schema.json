{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arronix.invalid/verification/compatibility/replacement.schema.json",
  "title": "Arronix compatibility case replacement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "replacementId",
    "fromCaseId",
    "toCaseIds",
    "shape",
    "outcome",
    "coverage",
    "status",
    "rationale"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "replacementId": { "$ref": "#/$defs/stableId" },
    "fromCaseId": { "$ref": "#/$defs/stableId" },
    "toCaseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "shape": { "enum": ["one-to-one", "partition"] },
    "outcome": {
      "enum": [
        "equivalent",
        "ownership-correct",
        "evidence-recovered",
        "approved-divergence",
        "scope-correction"
      ]
    },
    "coverage": { "enum": ["partial", "full"] },
    "status": { "enum": ["candidate", "approved", "verified"] },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
    "decisionReference": { "$ref": "#/$defs/stableId" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "coverage": { "const": "partial" } },
        "required": ["coverage"]
      },
      "then": { "properties": { "status": { "const": "candidate" } } }
    },
    {
      "if": {
        "properties": { "status": { "const": "approved" } },
        "required": ["status"]
      },
      "then": { "required": ["decisionReference"] }
    },
    {
      "if": {
        "properties": { "shape": { "const": "one-to-one" } },
        "required": ["shape"]
      },
      "then": { "properties": { "toCaseIds": { "maxItems": 1 } } }
    },
    {
      "if": {
        "properties": { "shape": { "const": "partition" } },
        "required": ["shape"]
      },
      "then": { "properties": { "toCaseIds": { "minItems": 2 } } }
    },
    {
      "if": {
        "properties": { "outcome": { "enum": ["approved-divergence", "scope-correction"] } },
        "required": ["outcome"]
      },
      "then": { "required": ["decisionReference"] }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 240
    }
  }
}
